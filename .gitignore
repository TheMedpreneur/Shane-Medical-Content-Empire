# Unreal Engine 5 Project .gitignore

# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Derived Data Cache
UnrealProject/DerivedDataCache/*

# Crash logs
*.log

# Rider
.idea/
*.sln.iml

# macOS
.DS_Store
._*
Thumbs.db

# Backup files
*.bak
*.tmp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
*.egg-info/
dist/
build/

# Reports
reports/*.json
reports/*.md
!reports/.gitkeep

# Asset Registry (generated)
asset-registry.json

# Node modules (if using any JS tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package files
*.zip
*.tar.gz
*.rar
*.7z

# Backup files
backups/
*.backup

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
temp/
tmp/
*.tmp
*~

# Large media files (use Git LFS if needed)
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.flac
*.psd
*.ai

# Documentation build artifacts
docs/_build/
site/

# Test results
test-results/
coverage/

# Local environment files
.env
.env.local
.env.*.local

# Certificates and keys
*.pem
*.key
*.cert
*.crt

# Database files
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# AWS and Cloud credentials
.aws/
*credentials*
*.pem

# Keep empty directories
!.gitkeep
